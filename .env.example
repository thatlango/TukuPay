NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://tukupay:tukupay@localhost:5432/tukupay

# Break-glass/admin credential. Use a long random value outside source control.
TUKUPAY_SERVICE_TOKEN=replace-with-long-random-admin-token

# Preferred per-product identities and least-privilege scopes.
TUKUPAY_SERVICE_TOKENS_JSON={"kela":{"token":"replace-with-kela-token","scopes":["payments:create","payments:read","payments:refresh"]},"jakeos":{"token":"replace-with-jakeos-token","scopes":["ops:read","ops:balances"]}}
TUKUPAY_RATE_LIMIT_PER_MINUTE=600

# Test-only provider simulator. NEVER enable this in the production API once
# real operator credentials are present.
TUKUPAY_SIMULATOR_ENABLED=false
TUKUPAY_SIMULATOR_BALANCE=10000000

RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=15000
RECONCILIATION_BATCH_SIZE=50
TUKUPAY_PUBLIC_URL=https://payments.tukutuku.org

# Uganda — MTN MoMo Collections + Disbursements
MTN_UG_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_UG_TARGET_ENVIRONMENT=sandbox
MTN_UG_COLLECTION_SUBSCRIPTION_KEY=
MTN_UG_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_UG_API_USER=
MTN_UG_API_KEY=
MTN_UG_CALLBACK_URL=https://payments.tukutuku.org/webhooks/mtn/UG
MTN_UG_MSISDN_MODE=e164

# Uganda — Airtel Money Collections
AIRTEL_UG_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_UG_CLIENT_ID=
AIRTEL_UG_CLIENT_SECRET=
AIRTEL_UG_CALLBACK_URL=https://payments.tukutuku.org/webhooks/airtel/UG
AIRTEL_UG_API_VERSION=1
AIRTEL_UG_MSISDN_MODE=local
AIRTEL_UG_BALANCE_PATH=/standard/v1/users/balance

# Airtel disbursement remains disabled until Airtel Uganda provides the current
# security/signing contract and endpoint paths for the approved application.
AIRTEL_UG_DISBURSEMENT_PATH=
AIRTEL_UG_DISBURSEMENT_STATUS_PATH=

# Additional countries use the same PROVIDER_COUNTRY naming convention:
# MTN_RW_BASE_URL=
# MTN_RW_COLLECTION_SUBSCRIPTION_KEY=
# MTN_RW_DISBURSEMENT_SUBSCRIPTION_KEY=
# AIRTEL_RW_BASE_URL=
# AIRTEL_RW_CLIENT_ID=
# AIRTEL_RW_CLIENT_SECRET=
