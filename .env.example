NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://tukupay:tukupay@localhost:5432/tukupay

# Tuku service-to-service authentication. Replace in every non-local environment.
TUKUPAY_SERVICE_TOKEN=replace-with-a-long-random-local-dev-token

# Reconciliation worker
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=15000
RECONCILIATION_BATCH_SIZE=50

# Public callback base. Production must be HTTPS.
TUKUPAY_PUBLIC_URL=https://payments.tukutuku.org

# -----------------------------------------------------------------------------
# Uganda - MTN MoMo Collections
# Sandbox base: https://sandbox.momodeveloper.mtn.com
# Production base is supplied/confirmed during MTN onboarding.
# -----------------------------------------------------------------------------
MTN_UG_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_UG_TARGET_ENVIRONMENT=sandbox
MTN_UG_COLLECTION_SUBSCRIPTION_KEY=
MTN_UG_API_USER=
MTN_UG_API_KEY=
MTN_UG_CALLBACK_URL=https://payments.tukutuku.org/webhooks/mtn/UG
MTN_UG_MSISDN_MODE=e164

# -----------------------------------------------------------------------------
# Uganda - Airtel Money Collections
# UAT: https://openapiuat.airtel.africa
# Production: https://openapi.airtel.africa
# Keep API version configurable because Airtel app entitlements may differ.
# -----------------------------------------------------------------------------
AIRTEL_UG_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_UG_CLIENT_ID=
AIRTEL_UG_CLIENT_SECRET=
AIRTEL_UG_CALLBACK_URL=https://payments.tukutuku.org/webhooks/airtel/UG
AIRTEL_UG_API_VERSION=1
AIRTEL_UG_MSISDN_MODE=local

# Add countries without changing application code, for example:
# MTN_RW_BASE_URL=
# MTN_RW_TARGET_ENVIRONMENT=
# MTN_RW_COLLECTION_SUBSCRIPTION_KEY=
# MTN_RW_API_USER=
# MTN_RW_API_KEY=
# MTN_RW_CALLBACK_URL=https://payments.tukutuku.org/webhooks/mtn/RW
# MTN_RW_MSISDN_MODE=e164
#
# AIRTEL_RW_BASE_URL=
# AIRTEL_RW_CLIENT_ID=
# AIRTEL_RW_CLIENT_SECRET=
# AIRTEL_RW_CALLBACK_URL=https://payments.tukutuku.org/webhooks/airtel/RW
# AIRTEL_RW_API_VERSION=1
# AIRTEL_RW_MSISDN_MODE=local
