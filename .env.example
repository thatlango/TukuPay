NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://tukupay:tukupay@localhost:5432/tukupay

# Internal service authentication
TUKUPAY_SERVICE_TOKEN=replace-with-local-dev-token

# MTN MoMo
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=http://localhost:8080/webhooks/mtn

# Airtel Money - obtain exact Uganda app endpoints/credentials from developer portal
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_COUNTRY=UG
AIRTEL_MONEY_CURRENCY=UGX
AIRTEL_MONEY_CALLBACK_URL=https://payments.tukutuku.org/webhooks/airtel
